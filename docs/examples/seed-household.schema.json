{
  "$defs": {
    "ContactRole": {
      "description": "Closed list of the roles a contact can have (ADR 0024 decision 5).",
      "enum": [
        "emergency",
        "caregiver",
        "doctor",
        "key_holder",
        "neighbor",
        "trusted",
        "other"
      ],
      "title": "ContactRole",
      "type": "string"
    },
    "Guardianship": {
      "description": "Whether a child of the owner is still a minor; an adult child gets the partner's rule.",
      "enum": [
        "minor",
        "adult"
      ],
      "title": "Guardianship",
      "type": "string"
    },
    "SectionStatus": {
      "description": "What silence means in a section of the pool (ADR 0024 decision 2).",
      "enum": [
        "provided",
        "none",
        "unknown",
        "declined",
        "not_asked"
      ],
      "title": "SectionStatus",
      "type": "string"
    },
    "SeedChild": {
      "additionalProperties": false,
      "description": "A child of the owner; an adult child is the name and the guardianship only.",
      "properties": {
        "likes": {
          "default": [],
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Likes",
          "type": "array"
        },
        "dislikes": {
          "default": [],
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Dislikes",
          "type": "array"
        },
        "prefers": {
          "default": [],
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Prefers",
          "type": "array"
        },
        "name": {
          "maxLength": 80,
          "title": "Name",
          "type": "string"
        },
        "guardianship": {
          "$ref": "#/$defs/Guardianship"
        },
        "birth_date": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Birth Date"
        },
        "stated_age": {
          "anyOf": [
            {
              "maximum": 130,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stated Age"
        }
      },
      "required": [
        "name",
        "guardianship"
      ],
      "title": "SeedChild",
      "type": "object"
    },
    "SeedContact": {
      "additionalProperties": false,
      "description": "A person the owner wants called or told; repeating a person's name is that person.",
      "properties": {
        "name": {
          "maxLength": 80,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ContactRole"
        },
        "relationship": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship"
        },
        "phone": {
          "title": "Phone",
          "type": "string"
        },
        "phone_alt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone Alt"
        },
        "call_order": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Order"
        },
        "has_key": {
          "default": false,
          "title": "Has Key",
          "type": "boolean"
        },
        "may_receive_health_info": {
          "default": false,
          "title": "May Receive Health Info",
          "type": "boolean"
        },
        "may_view_activity": {
          "default": false,
          "title": "May View Activity",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "role",
        "phone"
      ],
      "title": "SeedContact",
      "type": "object"
    },
