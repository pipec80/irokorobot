# OMNiBot 2000 — environment variables
# Copy to .env and fill in real values. Never commit .env.

# ── Server (homelab) ──────────────────────────────────────────────────
# Local LLM provider (the server accepts only Ollama)
LLM_PROVIDER=ollama
# Spoken (via local TTS) when the LLM backend is unreachable
# LLM_FALLBACK_PHRASE="Uy, mi cerebro todavía se está despertando. Dame unos segundos y volvé a hablarme."

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# CPU-only chat calls can exceed 20s — must outlast the slowest real turn
OLLAMA_TIMEOUT_S=120

# Whisper STT
WHISPER_MODEL=small
WHISPER_LANGUAGE=es
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_INITIAL_PROMPT="Conversación con un robot doméstico llamado Iroko."
# WHISPER_HOTWORDS=Iroko,apagar,encender
WHISPER_HALLUCINATION_SILENCE_THRESHOLD=2.0
WHISPER_VAD_MIN_SILENCE_MS=500

# Piper TTS
PIPER_VOICE=es_MX-ald-medium
PIPER_SPEED=1.4
PIPER_NOISE_SCALE=0.8
PIPER_NOISE_W_SCALE=0.8
PIPER_USE_CUDA=false
MODELS_DIR=models

# FastAPI / uvicorn
# Desktop-safe default. To expose the server to a trusted LAN client, explicitly
# set SERVER_HOST=0.0.0.0 in your untracked .env after configuring that network.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOG_LEVEL=INFO
# Console output is human-readable; the rotating file is JSON Lines (one JSON
# object per line) so any analysis tool can ingest it. Rotated files are named
# server.<YYYY-MM-DD>.log and robot.<YYYY-MM-DD>.log.
LOG_TO_FILE=true
LOG_DIR=logs
LOG_RETENTION_DAYS=14
MAX_UPLOAD_BYTES=10485760
UVICORN_WORKERS=1
UVICORN_PROXY_HEADERS=false
UVICORN_LIMIT_CONCURRENCY=100
UVICORN_MAX_REQUESTS=1000

# ── Robot (Raspberry Pi 5) ────────────────────────────────────────────
# Use localhost or an explicit LAN IP — bare hostnames can be hijacked by ISP wildcard DNS
SERVER_URL=http://localhost:8000
# Full pipeline timeout — CPU-only Ollama can take >30s per turn.
# 300 (not 120): confirmed during M1 that a cold VLM+chat turn on
# non-dedicated hardware can take ~140s when Ollama unloaded the model
# (docs/bitacora/022_m1_walkthrough_sesion1.md).
SERVER_TIMEOUT_S=300

# VAD: "silero" (neural, default) or "rms" (energy threshold fallback).
# Silero needs a local model file — fetch it once with:
#   uv run --with silero-vad python scripts/fetch_silero_vad_model.py
# Missing/broken model degrades to RMS automatically (never crashes the robot).
VAD_ENGINE=silero
VAD_SILENCE_THRESHOLD_RMS=100
VAD_PREROLL_MS=400
VAD_SILENCE_MS=800
VAD_MODEL_PATH=models/silero_vad.onnx

# R3: sentence-streaming TTS via POST /transcribe/stream instead of the
# classic single-shot /transcribe. Default off — opt-in once validated.
# NOT compatible with VISION_ENABLED=true yet: streaming has no path for
# visual questions (F-08). The robot refuses to start if both are on —
# see docs/c-audit/auditoria-forense-codigo-2026-07-21.md.
ROBOT_STREAMING=false

# Plan 0026: prompt once at startup for the local owner PIN and carry the
# resulting one-use token through classic /transcribe turns. Classic mode
# only — the robot refuses to start if this and ROBOT_STREAMING are both
# true (streaming parity is Plan 0027). Default off.
ROBOT_OWNER_UNLOCK_PROMPT=false

# ── Brain & Memory (v3) ───────────────────────────────────────────────
# SQLite database file (relative to server/ or absolute)
BRAIN_DB_PATH=data/omnibot.db

# Embeddings via Ollama
# Dimension is fixed at 768 internally (server/src/server/memory/embeddings.py
# EMBEDDING_DIM) — not configurable, see docs/c-audit/
# auditoria-forense-codigo-2026-07-21.md F-04.
EMBEDDING_MODEL=nomic-embed-text

# Consolidation (fact extraction) model — decided by eval R8 (2026-07-14):
# qwen2.5:3b recall 0.65 vs qwen3:4b-instruct 0.95 (just eval-memory)
CONSOLIDATION_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Memory tuning
WORKING_MEMORY_SIZE=20
SEMANTIC_TOP_K=6

# Legacy identity metadata (not used as speaker identity or authorization)
DEFAULT_USER_ID=pipec
# Public voice and visual turns receive fresh request-local interaction scopes.
# They do not inherit another person's working memory.

# Re-read character markdown profiles on change (prompt-engineering aid).
# Keep false in production so behavior is reproducible from a commit; set
# true only in a dev shell to iterate on a profiles/*.md live.
CHARACTER_HOT_RELOAD=false

# Kill-switch (set false to debug without memory)
MEMORY_ENABLED=true

# ── Vision V0 ─────────────────────────────────────────────────────────
# Kill-switch (same pattern as MEMORY_ENABLED) — off by default
# NOT compatible with ROBOT_STREAMING=true yet (F-08, see that flag above)
VISION_ENABLED=false
# VLM for /vision/describe. Instruct variant on purpose (thinking models
# exceed CPU timeouts — lesson from R8). Homelab: qwen3-vl:8b.
VLM_MODEL=qwen3-vl:2b-instruct
# Spoken cue while the VLM thinks ("¿qué ves?" flow, V0.5)
# VISION_LOOK_PHRASE="A ver, déjame mirar..."
# Faces (V1): InsightFace model (downloads to MODELS_DIR/insightface on
# first use, ~300 MB) and cosine-DISTANCE match threshold (0 = identical;
# calibrate with the real family). This sample override (0.65) intentionally
# differs from the technical default (0.4) pending a reproducible calibration;
# P0-S2 does not select a final threshold by intuition.
FACE_MODEL=buffalo_l
FACE_MATCH_THRESHOLD=0.65
# Owner authentication (Plan 0029): separate, STRICTER threshold than the
# generic conversational match above — a face allowed to unlock protected
# data must clear a tighter bound (technical default 0.25).
FACE_AUTHENTICATION_MATCH_THRESHOLD=0.25
# Enrollment quality gates: reject blurry/tiny faces upfront (V1.1)
FACE_ENROLL_MIN_SCORE=0.5
FACE_ENROLL_MIN_WIDTH=80
# Drop-folder for enrollment photos (gitignored - family photos never commit)
IMAGES_DIR=server/src/server/images

# Sensor hub
SENSOR_DEBOUNCE_SECONDS=30
SENSOR_DELTA_THRESHOLD=0.5
SENSOR_RETENTION_HOURS=72
SENSOR_AGGREGATION_INTERVAL_SECONDS=3600

# Dashboard
DASHBOARD_ENABLED=true
